{
  "name": "oriket-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "android:prepare": "npm install --no-save --package-lock=false @capacitor/core@7.4.3 @capacitor/android@7.4.3 @capacitor/cli@7.4.3 @capacitor/app@7.0.1 @capacitor/browser@7.0.1",
    "android:add": "npm run android:prepare && npx cap add android",
    "android:build": "npm run build && npx cap sync android && node scripts/prepare-capacitor-android.mjs && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
