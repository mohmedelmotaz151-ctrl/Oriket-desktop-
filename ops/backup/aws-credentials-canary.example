# AWS credentials canary (local setup)

This file is a template only. Replace the placeholders locally with the AWS API key pair generated by your Canarytokens account.

Do not use real AWS account credentials here.
Do not put this file in application assets or bundle it into the APK.
Keep the completed canary file out of release artifacts.

[default]
aws_access_key_id = REPLACE_WITH_CANARY_ACCESS_KEY_ID
aws_secret_access_key = REPLACE_WITH_CANARY_SECRET_ACCESS_KEY
output = json
region = us-east-2
